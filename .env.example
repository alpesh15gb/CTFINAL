# Storefront build-time config. Compose auto-loads this file for the
# `build.args` interpolation in docker-compose.yml (it is NOT sent into
# containers). Copy to real values and rebuild the storefront:
#   cp .env.example .env   # then edit
#   docker compose up -d --build cartunez

# Public Medusa URL called directly by shoppers' browsers.
# MUST be publicly reachable (a container-internal hostname will not work).
STOREFRONT_MEDUSA_URL=http://localhost:9000

# Publishable key from Medusa admin:
# /admin -> Settings -> API Key Management -> Publishable -> Create.
MEDUSA_PUBLISHABLE_KEY=pk_-replace-me
