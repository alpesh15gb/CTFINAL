# Instagram Graph API Configuration
INSTAGRAM_ACCESS_TOKEN=your_access_token_here
INSTAGRAM_USER_ID=your_instagram_user_id_here

# Medusa storefront
# Production browser requests use the same public Cartunez origin through nginx /store.
# For local Next.js development, uncomment this so the browser talks to local Medusa directly.
# NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Optional: pin cart creation to a specific Medusa region / sales channel.
# NEXT_PUBLIC_MEDUSA_REGION_ID=reg_...
# NEXT_PUBLIC_MEDUSA_SALES_CHANNEL_ID=sc_...

# Server-side/internal Docker Medusa URL (docker-compose sets this automatically).
# MEDUSA_BACKEND_URL=http://cartunez-medusa:9000

# Medusa runtime secrets. docker-compose loads these from .env.local into the Medusa container.
JWT_SECRET=replace_with_a_long_random_secret
COOKIE_SECRET=replace_with_a_different_long_random_secret

# Optional initial admin creation. Leave blank when the admin already exists.
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=
