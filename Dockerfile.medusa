FROM node:20-alpine

WORKDIR /app

# Install Medusa CLI and dependencies
RUN npm install -g @medusajs/medusa-cli

COPY package.json package-lock.json ./
RUN npm install --production=false

COPY medusa-config.js babel.config.js ./
COPY data/ ./data/
COPY src/ ./src/

# Run migrations and seed on first start, then start server
CMD ["sh", "-c", "medusa migrations run && medusa user -e admin@cartunez.in -p CartunezAdmin2024! || true && medusa develop --host 0.0.0.0"]
