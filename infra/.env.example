# Copy to infra/.env and fill in. Never commit infra/.env (REQ-INF-3).

POSTGRES_PASSWORD=change-me-strong-password
JWT_SECRET=generate-64-hex-chars
COOKIE_SECRET=generate-64-hex-chars

# Public URLs (production)
BACKEND_URL=https://api.cartunez.in
PUBLIC_BACKEND_URL=https://api.cartunez.in
STORE_CORS=https://cartunez.in,https://www.cartunez.in
ADMIN_CORS=https://api.cartunez.in
AUTH_CORS=https://api.cartunez.in

# From `npm run seed` output (or Medusa admin -> Settings -> Publishable API Keys)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...

# Razorpay dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

NEXT_PUBLIC_WHATSAPP_NUMBER=919949695030
